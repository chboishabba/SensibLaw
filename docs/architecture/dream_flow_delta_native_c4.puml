@startuml
!include <C4/C4_Container>

LAYOUT_LEFT_RIGHT()

title ITIR / SensibLaw delta-native PNF execution strategy

Person(operator, "Operator / benchmark owner", "Selects a frozen workload and reviews acceptance evidence")

System_Boundary(sensiblaw, "SensibLaw / ITIR semantic compiler authority") {
    Container(parser, "spaCy parser adapter", "Python + spaCy", "Produces one typed numeric observation stream; no semantic authority")
    Container(local, "Packed fibre-local execution strategy", "Python numeric buffers; native candidate", "Owns token-local addressing, local PNF solve, residual joins, delta composition and hierarchy transport")
    Container(sparse, "Sparse closure strategy", "Custom worklist / PG / Zelph / Datalog candidate", "Runs only genuinely sparse cross-fibre closure; engine must win the tournament")
    ContainerDb(pg, "PostgreSQL authority", "PostgreSQL", "Durable semantic identity, indexed global relations, provenance, transaction boundary and rebuildable views")
    Container(accept, "Sprint acceptance constitution", "Python receipts + DASHI proofs", "Evaluates constraints, invariants, preconditions, postconditions, gap closure and physical work")
    Container(obs, "Measurement / work ledger", "Read-only benchmark instrumentation", "Measures parser time, post-parser time, work, boundary crossings, bytes and kernel attribution")
}

System_Ext(dashi, "DASHI Agda formal model", "Defines delta algebra, fibres, natural transport, placement, engine tournament and O/R/C/S/L/P/G/F sprint constitution")
System_Ext(external, "Optional external evidence providers", "Revisioned evidence only; never semantic authority")

Rel(operator, accept, "Reviews acceptance receipt")
Rel(parser, local, "Typed numeric observations")
Rel(local, pg, "Fused authority deltas and cache-miss batches")
Rel(pg, local, "Compact globally indexed candidate fibres / stable IDs")
Rel(local, sparse, "Only unresolved global/cross-fibre residuals")
Rel(sparse, pg, "Derived closure deltas; authority remains in PG")
Rel(external, pg, "Bounded revisioned evidence through governed adapters")
Rel(parser, obs, "Parser timing/work")
Rel(local, obs, "Local fibre work")
Rel(sparse, obs, "Sparse closure work")
Rel(pg, obs, "Publication/global lookup work")
Rel(obs, accept, "Physical evidence")
Rel(dashi, accept, "Formal obligations and gap model")
Rel(dashi, local, "Reference execution laws")
Rel(dashi, sparse, "Engine-admission laws")

SHOW_LEGEND()
@enduml
