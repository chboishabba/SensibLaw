# Optional Wikidata live-replay identity. Keep actual values in a local .env
# (ignored by git) and source it before invoking the materializer.

# PostgreSQL target for the last complete local tranche run. This points at a
# disposable test cluster under /tmp; see docs/postgres_runtime.md before use.
# DATABASE_URL=postgresql://postgres@127.0.0.1:5433/sensiblaw_tranche

# Bounded active-document execution is enabled by default. Set to 0 only for
# serial/parity diagnosis. The soft limit defers work and compacts history; the
# hard limit stops only after relief attempts fail. Checkpoints are optional.
SENSIBLAW_BOUNDED_DOCUMENT_EXECUTION=1
SENSIBLAW_INDEXED_SEMANTIC_PROJECTION=1
SENSIBLAW_DOCUMENT_RETENTION_MODE=production_compact
SENSIBLAW_DOCUMENT_SOFT_MEMORY_MIB=6144
SENSIBLAW_DOCUMENT_HARD_MEMORY_MIB=8192
SENSIBLAW_DOCUMENT_RECOVERY_MEMORY_MIB=5120
SENSIBLAW_DOCUMENT_QUEUE_LIMIT_MIB=64
SENSIBLAW_DOCUMENT_MAX_IN_FLIGHT=8
SENSIBLAW_DOCUMENT_COMPACTION_ATTEMPTS=3
SENSIBLAW_DOCUMENT_MINIMUM_RECOVERY_MIB=64
# SENSIBLAW_RESOURCE_CHECKPOINT_DIR=/tmp/sensiblaw-resource-checkpoints

# Stage-local budgets fail before one stage consumes the complete global
# envelope. Values are MiB and may be lowered for CI or capacity testing.
SENSIBLAW_STAGE_PARSER_PROJECTION_SOFT_MIB=3072
SENSIBLAW_STAGE_PARSER_PROJECTION_HARD_MIB=4096
SENSIBLAW_STAGE_TYPING_SOFT_MIB=4096
SENSIBLAW_STAGE_TYPING_HARD_MIB=5120
SENSIBLAW_STAGE_CLOSURE_SOFT_MIB=5120
SENSIBLAW_STAGE_CLOSURE_HARD_MIB=6144
SENSIBLAW_STAGE_FINALIZATION_SOFT_MIB=4096
SENSIBLAW_STAGE_FINALIZATION_HARD_MIB=5632
SENSIBLAW_STAGE_SERIALIZATION_SOFT_MIB=2048
SENSIBLAW_STAGE_SERIALIZATION_HARD_MIB=3072
SENSIBLAW_STAGE_PUBLICATION_SOFT_MIB=2048
SENSIBLAW_STAGE_PUBLICATION_HARD_MIB=3072
SENSIBLAW_STAGE_PARITY_SOFT_MIB=1536
SENSIBLAW_STAGE_PARITY_HARD_MIB=2560

# Finalisation emits bounded progress while sealing immutable families. The
# fresh serializer process receives only compact manifests and references.
SENSIBLAW_FINALIZATION_BATCH_SIZE=4096
SENSIBLAW_FINALIZATION_STALL_SECONDS=120

# Disk has an independent budget. Authoritative reusable checkpoints are never
# automatically deleted; derived and diagnostic artifacts require a registered
# successor before reclamation.
SENSIBLAW_CHECKPOINT_DISK_BUDGET_MIB=8192

# Initial persistent graph-hierarchy defaults. The hierarchy is an execution
# carrier over the canonical document graph, not a second semantic authority.
SENSIBLAW_HIERARCHY_LEAF_CAPACITY=4096
SENSIBLAW_HIERARCHY_ARITY=4

# Output-sensitive local typing and differential closure. The semantic
# checkpoint directory retains immutable typing leaves, hierarchy receipts,
# solver receipts, resource timelines and amplification reports. Worker count,
# leaf capacity and completion order have no semantic effect.
SENSIBLAW_TYPING_WORKERS=4
SENSIBLAW_TYPING_LEAF_CAPACITY=4096
SENSIBLAW_TYPING_HIERARCHY_ARITY=4
SENSIBLAW_TYPING_RELATION_LEAF_SIZE=4096
SENSIBLAW_TYPING_MENTION_LEAF_SIZE=4096
# SENSIBLAW_SEMANTIC_CHECKPOINT_DIR=/tmp/sensiblaw-semantic-checkpoints

# CPU-bound semantic leaves and pure closure jobs use a bounded process pool so
# four workers can use four cores without loading four spaCy/parser runtimes.
# Worker inputs contain bounded leaves/jobs only; the pool exits before SQL
# persistence. Set to 1 for deterministic serial diagnosis.
SENSIBLAW_SEMANTIC_PROCESS_WORKERS=4
SENSIBLAW_TYPING_OVERLAP_PROCESS_WORKERS=4
SENSIBLAW_SEMANTIC_MP_CONTEXT=forkserver

# Multi-machine workers lease execution.semantic_job rows from PostgreSQL,
# renew their fencing epoch while computing, and submit immutable deltas through
# revision compare-and-swap. These values are deployment defaults, not semantic
# inputs.
SENSIBLAW_DISTRIBUTED_LEASE_SECONDS=300
SENSIBLAW_DISTRIBUTED_LEASE_BATCH=1

# Failure injection for checkpoint/resume tests only. Leave unset in ordinary
# compilation.
# SENSIBLAW_TYPING_STOP_AFTER_LEAVES=1
# SENSIBLAW_TYPING_TAIL_STOP_AFTER_LEAVES=1
# SENSIBLAW_CLOSURE_STOP_AFTER_RECEIPTS=1

SENSIBLAW_WIKIDATA_CONTACT_NAME=
SENSIBLAW_WIKIDATA_CONTACT_EMAIL=

# Optional OAuth 2 access token. Never commit a token or place it in artifacts.
SENSIBLAW_WIKIDATA_OAUTH_ACCESS_TOKEN=
